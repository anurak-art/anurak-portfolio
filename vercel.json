{
  "functions": {
    "api/blog.js": {
      "includeFiles": "content/blog.json"
    },
    "api/sitemap.js": {
      "includeFiles": "content/blog.json"
    },
    "api/latest.js": {
      "includeFiles": "content/blog.json"
    },
    "api/news.js": {
      "maxDuration": 30
    },
    "api/footprint.js": {
      "includeFiles": "content/wmn-data.json",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/footprint",
      "destination": "/footprint.html"
    },
    {
      "source": "/blog",
      "destination": "/api/blog?lang=th"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?lang=th&slug=:slug"
    },
    {
      "source": "/en/blog",
      "destination": "/api/blog?lang=en"
    },
    {
      "source": "/en/blog/:slug",
      "destination": "/api/blog?lang=en&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "buildCommand": "node scripts/prerender.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/api/(news|latest)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/footprint",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
